datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum SlotStatus {
  AVAILABLE
  HELD
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum AppointmentStatus {
  UPCOMING
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum ReminderStatus {
  PENDING
  SENT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(PATIENT)
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctor               Doctor?
  patientAppointments  Appointment[]        @relation("PatientAppointments")
  patientPrescriptions Prescription[]       @relation("PatientPrescriptions")
  medicationReminders  MedicationReminder[]
  calendarConnection   CalendarConnection?
}

model Doctor {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                 String?
  specialization      String
  slotDurationMinutes Int      @default(30)
  isActive            Boolean  @default(true)
  avatarUrl           String?
  rating              Float    @default(4.9)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workingHours        DoctorWorkingHours[]
  leaves              DoctorLeave[]
  slots               AppointmentSlot[]
  doctorAppointments  Appointment[]        @relation("DoctorAppointments")
  doctorPrescriptions Prescription[]       @relation("DoctorPrescriptions")

  @@index([specialization])
  @@index([isActive])
}

model DoctorWorkingHours {
  id        String @id @default(uuid())
  doctorId  String
  doctor    Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek Int    // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  startTime String // e.g. "09:00"
  endTime   String // e.g. "17:00"

  @@unique([doctorId, dayOfWeek])
}

model DoctorLeave {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  leaveDate String   // YYYY-MM-DD
  reason    String?
  createdAt DateTime @default(now())

  @@unique([doctorId, leaveDate])
  @@index([doctorId])
  @@index([leaveDate])
}

model AppointmentSlot {
  id            String     @id @default(uuid())
  doctorId      String
  doctor        Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date          String     // YYYY-MM-DD
  startTime     String     // e.g. "09:00"
  endTime       String     // e.g. "09:30"
  status        SlotStatus @default(AVAILABLE)
  holdToken     String?
  holdExpiresAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  appointment Appointment?

  // HARD DATABASE CONSTRAINT AGAINST DOUBLE-BOOKING SAME SLOT FOR A DOCTOR
  @@unique([doctorId, date, startTime])
  @@index([doctorId])
  @@index([date])
  @@index([status])
}

model Appointment {
  id                  String            @id @default(uuid())
  slotId              String?           @unique
  slot                AppointmentSlot?  @relation(fields: [slotId], references: [id], onDelete: SetNull)
  patientId           String
  patient             User              @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId            String
  doctor              Doctor            @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  date                String            // YYYY-MM-DD
  startTime           String            // "09:00"
  endTime             String            // "09:30"
  symptoms            String
  status              AppointmentStatus @default(UPCOMING)
  urgency             UrgencyLevel      @default(LOW)
  chiefComplaint      String?
  aiPreVisitSummary   Json?
  clinicalNotes       String?
  doctorNotesPatient  String?
  aiPostVisitSummary  Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  prescription   Prescription?
  calendarEvents CalendarEvent[]

  @@index([patientId])
  @@index([doctorId])
  @@index([date])
  @@index([status])
}

model Prescription {
  id            String             @id @default(uuid())
  appointmentId String             @unique
  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User               @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor             @relation("DoctorPrescriptions", fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())
  items         PrescriptionItem[]
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineName   String
  dosage         String
  frequency      String
  duration       String
  instructions   String?

  medicationReminders MedicationReminder[]
}

model MedicationReminder {
  id                 String         @id @default(uuid())
  prescriptionItemId String
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id], onDelete: Cascade)
  patientId          String
  patient            User           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  reminderTime       String         // e.g. "08:00"
  frequency          String         // "Once daily", "Twice daily", etc.
  status             ReminderStatus @default(PENDING)
  lastSentAt         DateTime?
  createdAt          DateTime       @default(now())
}

model NotificationJob {
  id             String             @id @default(uuid())
  type           String             // BOOKING_CONFIRMATION, APPOINTMENT_REMINDER, CANCELLATION, RESCHEDULE, DOCTOR_LEAVE, POST_VISIT, MEDICATION_REMINDER
  recipientEmail String
  payload        Json
  attempts       Int                @default(0)
  maxAttempts    Int                @default(3)
  status         NotificationStatus @default(PENDING)
  scheduledAt    DateTime           @default(now())
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime           @default(now())

  @@index([status])
  @@index([scheduledAt])
}

model CalendarConnection {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String   @default("GOOGLE")
  accessToken      String
  refreshToken     String?
  expiresAt        DateTime?
  googleCalendarId String?  @default("primary")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CalendarEvent {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  userId        String
  googleEventId String
  createdAt     DateTime    @default(now())
}
